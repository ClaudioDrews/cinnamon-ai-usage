msgstr "Resposta do coletor não é JSON válido."

#: backend/window.py:397
msgid "Collector response is outside the contract."
msgstr "Resposta do coletor fora do contrato."

#: backend/window.py:424
msgid "Monitored AI services"
msgstr "Serviços de IA monitorados"

#: backend/window.py:435
msgid "For the project robot, install the librsvg2-common package"
msgstr "Para o robô do projeto, instale o pacote librsvg2-common"

#: backend/window.py:439
msgid "Update now (forces a new collection)"
msgstr "Atualizar agora (força nova coleta)"

#: backend/window.py:444
msgid "API keys and file paths: kept in the system keyring"
msgstr "Chaves de API e caminhos de arquivo: guardadas no cofre do sistema"

#: backend/window.py:465
msgid "Demo — made-up values, without changing your history."
msgstr "Demonstração — valores fictícios, sem alterar seu histórico."

#: backend/window.py:482
