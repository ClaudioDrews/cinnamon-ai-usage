#: backend/credentials_window.py:48
msgid "the key at /api/v1/key"
msgstr "a chave em /api/v1/key"

#: backend/credentials_window.py:49
msgid "the balance API key"
msgstr "a chave de API do saldo"

#: backend/credentials_window.py:50
msgid "the Go plan key (Zen does not work)"
msgstr "a chave do plano Go (Zen não serve)"

#: backend/credentials_window.py:51
msgid ""
"the Console management key → Settings → Management Keys (the inference one "
"does not work)"
msgstr "management key do Console → Settings → Management Keys (a de inferência não serve)"

#: backend/credentials_window.py:53
msgid "the account OAuth token"
msgstr "token OAuth da conta"

#: backend/credentials_window.py:110 backend/credentials_window.py:117
msgid "Credentials — AI usage"
msgstr "Credenciais — Uso de IA"

#: backend/credentials_window.py:118
msgid "Nothing here is written to the cache or the repository"
msgstr "Nada aqui é gravado no cache nem no repositório"

#: backend/credentials_window.py:136
msgid "System keyring unavailable: use a file indicated below."
msgstr "Cofre do sistema indisponível: use um arquivo indicado abaixo."

#: backend/credentials_window.py:165
msgid "API keys"
msgstr "Chaves de API"

#: backend/credentials_window.py:166
msgid ""
"The key goes to the system keyring (gnome-keyring) and is read by the "
"collector at query time. The field is cleared after saving."
msgstr "A chave vai para o cofre do sistema (gnome-keyring) e é lida pelo coletor na hora da consulta. O campo é limpo depois de salvar."

#: backend/credentials_window.py:181
#, python-brace-format
msgid "{variable} — {hint}"
msgstr "{variable} — {hint}"

#: backend/credentials_window.py:185
msgid "Save to the keyring"
msgstr "Salvar no cofre"

#: backend/credentials_window.py:187
msgid "Remove from the keyring"
msgstr "Remover do cofre"

#: backend/credentials_window.py:197
msgid "Credentials file (NAME=VALUE)"
msgstr "Arquivo de credenciais (NOME=VALOR)"

#: backend/credentials_window.py:198
msgid ""
"Use it when the keys are already in a file of yours, at any path (for "
"example ~/.env or ~/.config/secrets.env). The file is read without a shell."
msgstr "Use quando as chaves já estiverem em um arquivo seu, em qualquer caminho (por exemplo ~/.env ou ~/.config/secrets.env). O arquivo é lido sem shell."

#: backend/credentials_window.py:204
msgid "/path/to/credentials.env"
msgstr "/caminho/para/credenciais.env"

#: backend/credentials_window.py:206
msgid "Choose…"
msgstr "Escolher…"

#: backend/credentials_window.py:209 backend/credentials_window.py:252
msgid "Save path"
msgstr "Salvar caminho"

#: backend/credentials_window.py:218
msgid "Team identifiers"
msgstr "Identificadores do time"

#: backend/credentials_window.py:219
msgid ""
"Data that is not a secret, but the API requires — such as the xAI team. It "
"can come from here, from config.json or from the credentials file itself "
"(XAI_TEAM_ID)."
msgstr "Dados que não são segredo, mas a API exige — como o time da xAI. Podem vir daqui, de config.json ou do próprio arquivo de credenciais (XAI_TEAM_ID)."

#: backend/credentials_window.py:224
msgid "Grok / xAI — team_id"
msgstr "Grok / xAI — team_id"

#: backend/credentials_window.py:228
msgid "console.x.ai/team/&lt;team_id&gt;/…"
msgstr "console.x.ai/team/&lt;team_id&gt;/…"

#: backend/credentials_window.py:230
msgid "Save"
msgstr "Salvar"

#: backend/credentials_window.py:238
msgid "OAuth token in a JSON file"
msgstr "Token OAuth em arquivo JSON"

#: backend/credentials_window.py:239
msgid ""
"For services that authenticate by login instead of a key. The token is "
"looked up in the JSON, at any level; nothing is copied to the cache."
msgstr "Para serviços que autenticam por login em vez de chave. O token é procurado no JSON, em qualquer nível; nada é copiado para o cache."

#: backend/credentials_window.py:250
msgid "/path/to/auth.json"
msgstr "/caminho/para/auth.json"

#: backend/credentials_window.py:259
msgid "Without a key"
msgstr "Sem chave"

#: backend/credentials_window.py:260
msgid ""
"Codex uses the login of the CLI itself (codex login) and Antigravity uses "
"the local server of the open IDE — neither one asks for a key here."
msgstr "Codex usa o login do próprio CLI (codex login) e Antigravity usa o servidor local da IDE aberta — nenhum dos dois pede chave aqui."

#: backend/credentials_window.py:274
msgid "Type the credential before saving."
msgstr "Digite a credencial antes de salvar."

#: backend/credentials_window.py:279
#, python-brace-format
msgid "Could not write to the keyring: {error}"
msgstr "Não foi possível gravar no cofre: {error}"

#: backend/credentials_window.py:284
#, python-brace-format
msgid ""
"{label}: credential saved to the keyring as {variable}. The keyring has "
"precedence; the next collection already uses it."
msgstr "{label}: credencial guardada no cofre como {variable}. O cofre tem precedência; próxima coleta já usa."

#: backend/credentials_window.py:296
#, python-brace-format
msgid "Could not remove: {error}"
msgstr "Não foi possível remover: {error}"

#: backend/credentials_window.py:300
#, python-brace-format
msgid "{label}: removed from the keyring."
msgstr "{label}: removido do cofre."

#: backend/credentials_window.py:301
#, python-brace-format
msgid "{label}: there was nothing in the keyring."
msgstr "{label}: nada havia no cofre."

#: backend/credentials_window.py:305
msgid "Choose credentials file"
msgstr "Escolher arquivo de credenciais"

#: backend/credentials_window.py:307
msgid "Cancel"
msgstr "Cancelar"

#: backend/credentials_window.py:308
msgid "Choose"
msgstr "Escolher"

#: backend/credentials_window.py:317
msgid "Credentials file path updated."
msgstr "Caminho do arquivo de credenciais atualizado."

#: backend/credentials_window.py:323
#, python-brace-format
msgid "{done} The indicated file does not exist yet."
msgstr "{done} O arquivo indicado ainda não existe."

#: backend/credentials_window.py:329
msgid "The team_id accepts only letters, numbers, hyphen and underscore."
msgstr "O team_id aceita apenas letras, números, hífen e sublinhado."

#: backend/credentials_window.py:339
msgid "Team identifier updated."
msgstr "Identificador do time atualizado."

#: backend/credentials_window.py:350
#, python-brace-format
msgid "Token file for {service} updated."
msgstr "Arquivo de token do {service} atualizado."

#: backend/credentials_window.py:356
#, python-brace-format
msgid "Could not write the configuration: {error}"
msgstr "Não foi possível gravar a configuração: {error}"

#: backend/credentials_window.py:369
msgid "from the indicated token file"
msgstr "do arquivo de token indicado"

#: backend/credentials_window.py:378
#, python-brace-format
msgid ""
"{path} — {found} of {expected} expected variables found; the other variables "
"remain available to the connectors."
msgstr "{path} — {found} de {expected} variáveis esperadas encontradas; outras variáveis ficam disponíveis para os conectores."

#: backend/credentials_window.py:384
#, python-brace-format
msgid "{path} — the file does not exist yet."
msgstr "{path} — arquivo ainda não existe."

#: backend/credentials_window.py:388
#, python-brace-format
msgid " Line(s) ignored due to syntax: {lines}."
msgstr " Linha(s) ignorada(s) por sintaxe: {lines}."

#: backend/credentials_window.py:391
msgid "No file indicated."
msgstr "Nenhum arquivo indicado."

#: backend/credentials_window.py:395
msgid "not defined"
msgstr "não definido"

#: backend/credentials_window.py:396
#, python-brace-format
msgid "Current team_id: {value}"
msgstr "team_id atual: {value}"

#: backend/credentials_window.py:398
msgid " (from the configuration)"
msgstr " (da configuração)"

#: backend/credentials_window.py:400
msgid " (from the credentials file)"
msgstr " (do arquivo de credenciais)"

