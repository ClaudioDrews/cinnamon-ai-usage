msgstr "Falha na leitura: {services}"

#: applet/applet.js:444 applet/applet.js:505
msgid "Stale reading: {services}"
msgstr "Leitura antiga: {services}"

#: applet/applet.js:445
msgid "Click: recent · double-click: all"
msgstr "Clique: recentes · clique duplo: todos"

#: applet/applet.js:469
msgid "and {count} more"
msgstr "e mais {count}"

#: applet/applet.js:496
msgid "Five most recent · estimated usage"
msgstr "Cinco mais recentes · uso estimado"

#: applet/applet.js:498
