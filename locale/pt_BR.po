#: backend/collector.py:24
msgid "Last reading available; refresh pending."
msgstr "Última leitura disponível; atualização pendente."

#: backend/collector.py:40
msgid "No reading available; refresh to query."
msgstr "Nenhuma leitura disponível; atualize para consultar."

#: backend/collector.py:150
msgid ""
"Previous reading data: the refresh interval has passed and this service has "
"not been read again yet."
msgstr ""
"Dados da leitura anterior: o intervalo de atualização passou e ainda não "
"houve nova leitura deste serviço."

#: backend/collector.py:152
msgid "Previous reading data: the most recent refresh of this service failed."
msgstr ""
"Dados da leitura anterior: a atualização mais recente deste serviço falhou."

#: backend/collector.py:183
msgid ""
"Refresh skipped: a collection is already running; the values are the last "
"reading."
msgstr ""
"Atualização ignorada: já há uma coleta em andamento; os valores são os "
"últimos lidos."

#: backend/collector.py:317
msgid "Failed to read the configuration or write the local cache."
msgstr "Falha ao ler a configuração ou gravar o cache local."

