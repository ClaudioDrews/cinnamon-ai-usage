# Texto que fica no cache: mensagem e rótulo do contrato. O que se grava é este msgid; a
# tradução acima acontece na apresentação, no idioma em vigor na hora de mostrar.
#: backend/providers.py:48
msgid "Failed to query the service; the previous reading is kept."
msgstr "Não foi possível consultar o serviço; a leitura anterior é mantida."

#: backend/providers.py:756
msgid ""
"Reading reused; the subscription is queried respecting a minimum interval "
"between calls."
msgstr ""
"Leitura reaproveitada; a assinatura é consultada respeitando um intervalo "
"mínimo entre chamadas."

#: backend/providers.py:882
msgid ""
"Reading reused; the route is queried respecting a minimum interval between "
"calls."
msgstr ""
"Leitura reaproveitada; a rota é consultada respeitando um intervalo mínimo "
"entre chamadas."

#: backend/providers.py:1043
msgid "Failed to read the service data; try refreshing."
msgstr "Falha ao ler os dados do serviço; tente atualizar."

#: backend/window.py:704
msgid "Metric"
msgstr "Métrica"

# Nome, descrição e preferências do xlet (applet/metadata.json, applet/settings-schema.json)
msgid "Recent usage of the configured AI services, right in the Cinnamon panel"
msgstr ""
"Uso recente dos serviços de IA configurados, direto no painel do Cinnamon"

msgid "Collection"
msgstr "Coleta"

msgid "Usage collection"
msgstr "Coleta de uso"

msgid "Interface"
msgstr "Interface"

msgid "Collect usage periodically"
msgstr "Coletar uso periodicamente"

msgid ""
"When off, the applet keeps the last valid reading and stops querying the "
"services. No credential is stored here."
msgstr ""
"Quando desativado, o applet mantém a última leitura válida e para de "
"consultar os serviços. Nenhuma credencial é guardada aqui."

msgid "Interval between collections"
msgstr "Intervalo entre coletas"

msgid ""
"Time between two automatic readings. The Update button in the menu always "
"forces an immediate reading."
msgstr ""
"Tempo entre duas leituras automáticas. O botão Atualizar do menu sempre "
"força uma leitura na hora."

msgid "seconds"
msgstr "segundos"

msgid "Interface language"
msgstr "Idioma da interface"

msgid ""
"Automatic follows the session language; a fixed language also applies to the "
"collection, the usage window and the credentials window."
msgstr ""
"Automático segue o idioma da sessão; um idioma fixado vale também para a "
"coleta, a janela de uso e a de credenciais."

msgid "Automatic (system language)"
msgstr "Automática (idioma do sistema)"

msgid "English"
msgstr "English"

msgid "Português (Brasil)"
msgstr "Português (Brasil)"
